# Base URL of a running rag-agent for the live product demo.
# Local: http://127.0.0.1:8081 (docker compose maps host 8081 → container 8080)
# Production: https://demo.rag-agent.noematic.eu
#
# The agent must allow the website origin via RAG_CORS_ORIGINS (set in docker-compose.yml).
PUBLIC_RAG_AGENT_URL=http://127.0.0.1:8081

# Checkout URLs (optional — leave empty to fall back to contact@noematic.eu)
#
# Monthly supporter subscription (~2 €/mo) — Payhip:
#   https://payhip.com/b/Wj5Rl
PUBLIC_CHECKOUT_SUPPORTER_URL=

# Pay-what-you-want contribution — Lemon Squeezy (overlay embed on /pricing when URL is LS):
#   https://store.noematic.eu/checkout/buy/736733f7-41f5-42fe-adee-8560101545ab
PUBLIC_CHECKOUT_DONATION_URL=

# Alternative one-time donation — PayPal Donate or PayPal.me link:
PUBLIC_CHECKOUT_DONATION_PAYPAL_URL=
