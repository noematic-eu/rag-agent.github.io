---
import { t } from '../i18n/utils';

interface Props {
  locale: string;
}

const { locale } = Astro.props;

const items = [
  { q: 'pricing_faq_q1', a: 'pricing_faq_a1' },
  { q: 'pricing_faq_q2', a: 'pricing_faq_a2' },
  { q: 'pricing_faq_q3', a: 'pricing_faq_a3' },
  { q: 'pricing_faq_q4', a: 'pricing_faq_a4' },
] as const;
---

<section class="pricing-faq">
  <div class="container">
    <h2>{t(locale, 'pricing_faq_title')}</h2>
    <dl class="faq-list">
      {items.map(({ q, a }) => (
        <div class="faq-item">
          <dt>{t(locale, q)}</dt>
          <dd>{t(locale, a)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .pricing-faq {
    border-top: 1px solid var(--color-border);
    padding-block: 64px;
    background: var(--color-surface);
  }
  .pricing-faq h2 {
    font-size: 1.375rem;
    margin-bottom: 2rem;
  }
  .faq-list {
    display: grid;
    gap: 1.75rem;
    max-width: 640px;
  }
  .faq-item dt {
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.375rem;
  }
  .faq-item dd {
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }
</style>
