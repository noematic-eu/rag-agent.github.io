---
import { t } from '../i18n/utils';
import { GITHUB_AGENT } from '../site';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = locale === 'fr' ? `${base}fr/` : base;
---

<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <p class="pill">Local-first RAG · Open Source</p>
      <h1>{t(locale, 'hero_headline')}</h1>
      <p class="hero-sub">{t(locale, 'hero_subhead')}</p>
      <div class="hero-actions">
        <a href={`${prefix}contact`} class="btn btn-primary">{t(locale, 'hero_cta_pilot')}</a>
        <a href={GITHUB_AGENT} class="btn btn-outline" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          {t(locale, 'hero_cta_github')}
        </a>
      </div>
      <p class="hero-trust">{t(locale, 'hero_trust')}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 96px 80px;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-inner {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero h1 { color: var(--color-text); }
  .hero-sub {
    font-size: 1.125rem;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .hero-trust {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .hero { padding-block: 64px 48px; }
  }
</style>
