---
import { t } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = locale === 'fr' ? `${base}fr/` : base;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={prefix} class="logo" aria-label="Noematic home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2" y="2" width="9" height="9" rx="2" fill="currentColor" opacity="0.9"/>
        <rect x="13" y="2" width="9" height="9" rx="2" fill="currentColor" opacity="0.5"/>
        <rect x="2" y="13" width="9" height="9" rx="2" fill="currentColor" opacity="0.5"/>
        <rect x="13" y="13" width="9" height="9" rx="2" fill="currentColor" opacity="0.25"/>
      </svg>
      <span>Noematic</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href={`${prefix}products/rag-agent`}>{t(locale, 'nav_rag_agent')}</a>
      <a href={`${prefix}products/rag-router`}>{t(locale, 'nav_rag_router')}</a>
      <a href={`${prefix}pricing`}>{t(locale, 'nav_pricing')}</a>
      <a href={`${prefix}contact`}>{t(locale, 'nav_contact')}</a>
    </nav>

    <div class="header-actions">
      <LangSwitcher locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 250, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 60px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo:hover { color: var(--color-accent); text-decoration: none; }
  .nav {
    display: flex;
    gap: 1.75rem;
    flex: 1;
  }
  .nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav a:hover { color: var(--color-text); text-decoration: none; }
  .header-actions { margin-left: auto; }

  @media (max-width: 640px) {
    .nav { gap: 1rem; }
    .nav a { font-size: 0.8rem; }
  }
</style>
