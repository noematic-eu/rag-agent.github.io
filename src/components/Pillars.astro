---
import { t } from '../i18n/utils';

interface Props {
  locale?: string;
}
const { locale = 'en' } = Astro.props;

const pillars = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="2" y="2" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M7 7h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: t(locale, 'pillar_1_title'),
    body: t(locale, 'pillar_1_body'),
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5"/><path d="M10 6v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: t(locale, 'pillar_2_title'),
    body: t(locale, 'pillar_2_body'),
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><polyline points="3,13 7,9 10,12 14,7 17,10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    title: t(locale, 'pillar_3_title'),
    body: t(locale, 'pillar_3_body'),
  },
];
---

<section class="pillars">
  <div class="container">
    <p class="section-label">{t(locale, 'pillars_title')}</p>
    <div class="grid-3">
      {pillars.map((p) => (
        <div class="card pillar-card">
          <div class="pillar-icon" set:html={p.icon} />
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pillar-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: var(--color-accent-light);
    color: var(--color-accent);
  }
  .pillar-card h3 { color: var(--color-text); }
  .pillar-card p { font-size: 0.9375rem; }
</style>
