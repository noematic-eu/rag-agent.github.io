---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/utils';
import { CONTACT_EMAIL, GITHUB_AGENT, GITHUB_ROUTER } from '../site';

const locale = 'en';
const questions = [
  t(locale, 'contact_q1'),
  t(locale, 'contact_q2'),
  t(locale, 'contact_q3'),
  t(locale, 'contact_q4'),
];
---

<BaseLayout locale={locale} title={t(locale, 'contact_title')}>
  <section class="page-hero">
    <div class="container">
      <h1>{t(locale, 'contact_title')}</h1>
      <p class="page-intro">{t(locale, 'contact_subtitle')}</p>
    </div>
  </section>

  <section>
    <div class="container contact-grid">
      <div class="contact-main">
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-primary email-btn">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="1" y="4" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M1 6l8 5 8-5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {t(locale, 'contact_email_cta')}
        </a>
        <p class="contact-email-text">{CONTACT_EMAIL}</p>
      </div>

      <div class="contact-side">
        <div class="card">
          <p class="section-label">{t(locale, 'contact_discovery_title')}</p>
          <ul class="feature-list" style="margin-top:0.75rem">
            {questions.map((q) => <li>{q}</li>)}
          </ul>
        </div>

        <div class="card" style="margin-top:1.5rem">
          <p class="section-label">{t(locale, 'contact_github_title')}</p>
          <p style="margin-top:0.5rem;font-size:0.9375rem">{t(locale, 'contact_github_body')}</p>
          <div style="display:flex;gap:0.75rem;margin-top:1rem;flex-wrap:wrap">
            <a href={GITHUB_AGENT} class="btn btn-outline" target="_blank" rel="noopener">rag-agent ↗</a>
            <a href={GITHUB_ROUTER} class="btn btn-outline" target="_blank" rel="noopener">rag-router ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { padding-block: 80px 64px; border-bottom: 1px solid var(--color-border); }
  .page-hero .container { max-width: 680px; display: flex; flex-direction: column; gap: 1rem; }
  .page-intro { font-size: 1.0625rem; max-width: 52ch; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 5rem; align-items: start; }
  .contact-main { display: flex; flex-direction: column; gap: 0.75rem; }
  .email-btn { font-size: 1rem; padding: 0.8rem 1.6rem; }
  .contact-email-text { font-size: 0.875rem; color: var(--color-muted); }

  @media (max-width: 768px) { .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>
